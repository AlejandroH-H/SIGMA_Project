<div class="mx-auto max-w-lg text-center">
  <div class="rounded-xl border border-sigma-dark/10 bg-white p-10 shadow-sm">
    <div class="font-serif text-6xl font-bold text-sigma-accent"><%= typeof codigo !== 'undefined' ? codigo : 500 %></div>
    <p class="mt-4 text-sigma-dark/70"><%= typeof mensaje !== 'undefined' ? mensaje : 'Ocurrió un error.' %></p>
    <a href="/health" class="mt-6 inline-block rounded-md bg-sigma-dark px-4 py-2 text-sm font-medium text-sigma-cream transition-colors hover:bg-sigma-accent hover:text-sigma-dark">
      Ir a estado del sistema
    </a>
  </div>
</div>
