<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Iniciar sesión · SIGMA</title>
  <link rel="stylesheet" href="/css/output.css" />
</head>
<body class="min-h-screen bg-sigma-dark font-sans text-sigma-dark antialiased">
  <div class="flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm">
      <!-- Imagotipo -->
      <div class="mb-6 flex items-center justify-center gap-3 text-sigma-cream">
        <span class="flex h-11 w-11 items-center justify-center rounded-md bg-sigma-accent font-serif text-2xl font-bold text-sigma-dark">S</span>
        <div class="leading-tight">
          <div class="font-serif text-2xl tracking-wide">SIGMA</div>
          <div class="text-[10px] uppercase tracking-widest text-sigma-cream/60">Gestión Académica</div>
        </div>
      </div>

      <div class="rounded-xl bg-sigma-cream p-6 shadow-xl">
        <h1 class="font-serif text-xl text-sigma-dark">Iniciar sesión</h1>
        <p class="mt-1 text-sm text-sigma-dark/60">Accede con tus credenciales institucionales.</p>

        <% if (error) { %>
          <div class="mt-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
            <%= error %>
          </div>
        <% } %>

        <form method="POST" action="/login" class="mt-5 space-y-4">
          <div>
            <label for="email" class="block text-sm font-medium text-sigma-dark">Email</label>
            <input type="email" id="email" name="email" value="<%= email %>" required autofocus
              autocomplete="username"
              class="mt-1 w-full rounded-md border border-sigma-dark/15 bg-white px-3 py-2 text-sm text-sigma-dark outline-none focus:border-sigma-accent focus:ring-2 focus:ring-sigma-accent/30" />
          </div>
          <div>
            <label for="password" class="block text-sm font-medium text-sigma-dark">Contraseña</label>
            <input type="password" id="password" name="password" required
              autocomplete="current-password"
              class="mt-1 w-full rounded-md border border-sigma-dark/15 bg-white px-3 py-2 text-sm text-sigma-dark outline-none focus:border-sigma-accent focus:ring-2 focus:ring-sigma-accent/30" />
          </div>
          <button type="submit"
            class="w-full rounded-md bg-sigma-dark px-4 py-2.5 text-sm font-medium text-sigma-cream transition-colors hover:bg-sigma-accent hover:text-sigma-dark">
            Entrar
          </button>
        </form>
      </div>

      <p class="mt-4 text-center text-xs text-sigma-cream/50">
        SIGMA — Sistema de Información Gerencial Matricular y Académico
      </p>
    </div>
  </div>
</body>
</html>
