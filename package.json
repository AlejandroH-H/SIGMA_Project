{
  "name": "sigma",
  "version": "0.1.0",
  "description": "Sistema de Información Gerencial Matricular y Académico (SIGMA) — MVP",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "db:prepare": "tsx db/generate-admin-hash.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && npm run db:prepare && docker compose up -d",
    "css:dev": "tailwindcss -i src/styles/input.css -o public/css/output.css --watch",
    "css:build": "tailwindcss -i src/styles/input.css -o public/css/output.css --minify",
    "dev": "concurrently -n css,server -c magenta,green \"npm:css:dev\" \"tsx watch src/server.ts\"",
    "build": "tsc && npm run css:build",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "helmet": "^8.0.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
